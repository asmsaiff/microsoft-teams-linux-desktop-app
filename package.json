{
  "name": "teams-desktop",
  "productName": "Teams",
  "version": "1.0.1",
  "description": "Fast, hardened Microsoft Teams desktop client for Linux",
  "main": "src/main/main.js",
  "desktopName": "teams-desktop.desktop",
  "homepage": "https://github.com/asmsaiff/microsoft-teams-linux-desktop-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmsaiff/microsoft-teams-linux-desktop-app.git"
  },
  "bugs": {
    "url": "https://github.com/asmsaiff/microsoft-teams-linux-desktop-app/issues"
  },
  "author": {
    "name": "Mint Media Services",
    "email": "claude@mintmediaservices.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "electron scripts/render-icons.js",
    "check": "node --check src/main/*.js src/preload/*.js src/renderer/*.js scripts/*.js",
    "dist": "npm run icons && electron-builder --linux deb AppImage --publish never",
    "dist:deb": "npm run icons && electron-builder --linux deb --publish never",
    "fuses": "electron-fuses read --app dist/linux-unpacked/teams-desktop"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
